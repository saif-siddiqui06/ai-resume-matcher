# Copy this file to .env and fill in your values. Never commit .env.

# Required: your OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Optional: model and generation settings
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

# Optional: SQLite database path for analysis history
DATABASE_PATH=analyses.db

# Optional: URL the Streamlit frontend uses to reach the FastAPI backend
BACKEND_URL=http://localhost:8000
